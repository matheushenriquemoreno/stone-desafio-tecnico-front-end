# URL direta da API NestJS. A origem do front-end precisa estar autorizada na API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Origens HTTP(S) explícitas, separadas por vírgula, permitidas para imagens remotas.
# Exemplo: https://images.example.com,https://cdn.example.com
NEXT_PUBLIC_IMAGE_ORIGINS=
